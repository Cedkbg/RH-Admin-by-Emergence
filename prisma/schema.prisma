generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  admin
  employee
  secretaire
  dg
  dga
  manager
  assistant_direction
  rh

  @@map("app_role")
}

model AbsenceJustification {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String        @map("employee_id") @db.Uuid
  period         String
  reason         String
  status         String        @default("pending")
  reviewedBy     String?       @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_absence_justifications_org")
  @@map("absence_justifications")
}

model AgentReport {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String        @map("employee_id") @db.Uuid
  authorId         String        @map("author_id") @db.Uuid
  title            String
  reportType       String        @default("journalier") @map("report_type")
  periodStart      DateTime?     @map("period_start") @db.Date
  periodEnd        DateTime?     @map("period_end") @db.Date
  content          String
  status           String        @default("submitted")
  reviewComment    String?       @map("review_comment")
  reviewedBy       String?       @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  reference        String?
  category         String?
  confidentiality  String        @default("confidentiel")
  departmentId     String?       @map("department_id") @db.Uuid
  executiveSummary String?       @map("executive_summary")
  attachments      Json          @default("[]")
  organizationId   String?       @map("organization_id") @db.Uuid
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department       Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([employeeId], map: "idx_agent_reports_employee")
  @@index([status], map: "idx_agent_reports_status")
  @@index([createdAt], map: "idx_agent_reports_created")
  @@index([organizationId], map: "idx_agent_reports_org")
  @@map("agent_reports")
}

model Announcement {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  content        String
  authorId       String?       @map("author_id") @db.Uuid
  pinned         Boolean       @default(false)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_announcements_org")
  @@map("announcements")
}

model AppSetting {
  key            String
  value          Json
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
  @@index([organizationId], map: "idx_app_settings_org")
  @@map("app_settings")
}

model Appointment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  description     String?
  scheduledAt     DateTime      @map("scheduled_at") @db.Timestamptz(6)
  durationMinutes Int?          @default(30) @map("duration_minutes")
  location        String?
  attendees       String?
  forWho          String?       @default("manager") @map("for_who")
  status          String        @default("scheduled")
  createdBy       String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  organizationId  String?       @map("organization_id") @db.Uuid
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_appointments_org")
  @@map("appointments")
}

model AssistantRecord {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  category         String        @default("dossier")
  description      String?
  relatedDirection String?       @map("related_direction")
  priority         String        @default("medium")
  status           String        @default("open")
  dueDate          DateTime?     @map("due_date") @db.Date
  createdBy        String?       @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  organizationId   String?       @map("organization_id") @db.Uuid
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_assistant_records_org")
  @@map("assistant_records")
}

model Attendance {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String              @map("employee_id") @db.Uuid
  date           DateTime            @default(dbgenerated("CURRENT_DATE")) @db.Date
  checkIn        DateTime?           @map("check_in") @db.Time(6)
  checkOut       DateTime?           @map("check_out") @db.Time(6)
  status         String              @default("present")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  locationId     String?             @map("location_id") @db.Uuid
  scanMethod     String?             @map("scan_method")
  gpsLat         Float?              @map("gps_lat")
  gpsLng         Float?              @map("gps_lng")
  distanceMeters Decimal?            @map("distance_meters") @db.Decimal
  organizationId String?             @map("organization_id") @db.Uuid
  employee       Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location       AttendanceLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([employeeId, date], map: "idx_attendance_employee_date")
  @@index([organizationId], map: "idx_attendance_org")
  @@map("attendance")
}

model AttendanceLocation {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  address        String?
  latitude       Float
  longitude      Float
  radiusMeters   Int           @default(50) @map("radius_meters")
  secret         String        @default(dbgenerated("encode(gen_random_bytes(32), 'hex')"))
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  attendance     Attendance[]
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_attendance_locations_org")
  @@map("attendance_locations")
}

model AuditLog {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId        String?       @map("actor_id") @db.Uuid
  action         String
  entity         String?
  entityId       String?       @map("entity_id") @db.Uuid
  details        Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_audit_logs_org")
  @@map("audit_logs")
}

model BreakSession {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String        @map("employee_id") @db.Uuid
  organizationId   String?       @map("organization_id") @db.Uuid
  date             DateTime      @default(dbgenerated("((now() AT TIME ZONE 'Africa/Kinshasa'::text))::date")) @db.Date
  status           String        @default("pending")
  scheduledAt      DateTime?     @map("scheduled_at") @db.Timestamptz(6)
  postponedMinutes Int           @default(0) @map("postponed_minutes")
  startedAt        DateTime?     @map("started_at") @db.Timestamptz(6)
  endedAt          DateTime?     @map("ended_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization     Organization? @relation(fields: [organizationId], references: [id])

  @@unique([employeeId, date], map: "break_sessions_unique_day")
  @@index([date], map: "break_sessions_date_idx")
  @@map("break_sessions")
}

model Candidate {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobOfferId     String?       @map("job_offer_id") @db.Uuid
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  email          String?
  phone          String?
  status         String        @default("new")
  notes          String?
  appliedAt      DateTime?     @default(dbgenerated("CURRENT_DATE")) @map("applied_at") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  jobOffer       JobOffer?     @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_candidates_org")
  @@map("candidates")
}

model Contact {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName         String        @map("full_name")
  organizationName String?       @map("organization")
  position         String?
  email            String?
  phone            String?
  category         String?       @default("external")
  notes            String?
  createdBy        String?       @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  organizationId   String?       @map("organization_id") @db.Uuid
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_contacts_org")
  @@map("contacts")
}

model Department {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  directionId    String        @map("direction_id") @db.Uuid
  code           String?
  name           String
  description    String?
  managerName    String?       @map("manager_name")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  direction      Direction     @relation(fields: [directionId], references: [id], onDelete: Cascade)
  employees      Employee[]
  agentReports   AgentReport[]
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([directionId], map: "idx_departments_direction_id")
  @@index([organizationId], map: "idx_departments_org")
  @@map("departments")
}

model Direction {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  code           String?
  managerName    String?       @map("manager_name")
  description    String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  employees      Employee[]
  jobOffers      JobOffer[]
  departments    Department[]
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code], map: "directions_org_code_key")
  @@index([organizationId], map: "idx_directions_org")
  @@map("directions")
}

model DirectionExecutive {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  directionId    String        @map("direction_id") @db.Uuid
  role           AppRole
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, directionId, role])
  @@index([organizationId], map: "idx_direction_executives_org")
  @@map("direction_executives")
}

model Document {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  category       String?
  fileUrl        String?       @map("file_url")
  employeeId     String?       @map("employee_id") @db.Uuid
  uploadedBy     String?       @map("uploaded_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  employee       Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_documents_org")
  @@map("documents")
}

model Employee {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matricule          String?             @unique
  firstName          String              @map("first_name")
  lastName           String              @map("last_name")
  email              String?
  phone              String?
  position           String?
  directionId        String?             @map("direction_id") @db.Uuid
  status             String              @default("active")
  hireDate           DateTime?           @map("hire_date") @db.Date
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  departmentId       String?             @map("department_id") @db.Uuid
  contractType       String?             @map("contract_type")
  gender             String?
  address            String?
  birthDate          DateTime?           @map("birth_date") @db.Date
  baseSalary         Decimal?            @default(0) @map("base_salary") @db.Decimal
  managerId          String?             @map("manager_id") @db.Uuid
  hourlyRate         Decimal?            @default(0) @map("hourly_rate") @db.Decimal
  direction          Direction?          @relation(fields: [directionId], references: [id], onDelete: SetNull)
  department         Department?         @relation(fields: [departmentId], references: [id])
  attendance         Attendance[]
  breakSessions      BreakSession[]
  documents          Document[]
  leaveRequests      LeaveRequest[]
  payroll            Payroll[]
  performanceReviews PerformanceReview[]
  talents            Talent[]
  wellbeingSurveys   WellbeingSurvey[]
  agentReports       AgentReport[]
  assignedTasks      Task[]
  organizationId     String?             @map("organization_id") @db.Uuid
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_employees_org")
  @@map("employees")
}

model JobOffer {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  directionId    String?       @map("direction_id") @db.Uuid
  description    String?
  location       String?
  contractType   String?       @map("contract_type")
  status         String        @default("open")
  postedAt       DateTime?     @default(dbgenerated("CURRENT_DATE")) @map("posted_at") @db.Date
  closingDate    DateTime?     @map("closing_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  direction      Direction?    @relation(fields: [directionId], references: [id], onDelete: SetNull)
  candidates     Candidate[]
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_job_offers_org")
  @@map("job_offers")
}

model LeaveRequest {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String        @map("employee_id") @db.Uuid
  leaveType      String        @default("paid") @map("leave_type")
  startDate      DateTime      @map("start_date") @db.Date
  endDate        DateTime      @map("end_date") @db.Date
  reason         String?
  status         String        @default("pending")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  attachmentUrl  String?       @map("attachment_url")
  reviewComment  String?       @map("review_comment")
  reviewedBy     String?       @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_leave_requests_org")
  @@map("leave_requests")
}

model LegalRecord {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  type           String?
  description    String?
  status         String        @default("active")
  dueDate        DateTime?     @map("due_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_legal_records_org")
  @@map("legal_records")
}

model MailRegister {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  direction      String        @default("incoming")
  reference      String?
  subject        String
  sender         String?
  recipient      String?
  mailDate       DateTime      @default(dbgenerated("CURRENT_DATE")) @map("mail_date") @db.Date
  status         String        @default("received")
  notes          String?
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_mail_register_org")
  @@map("mail_register")
}

model MeetingMinute {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  meetingDate    DateTime      @default(dbgenerated("CURRENT_DATE")) @map("meeting_date") @db.Date
  attendees      String?
  agenda         String?
  decisions      String?
  nextSteps      String?       @map("next_steps")
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_meeting_minutes_org")
  @@map("meeting_minutes")
}

model Notification {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  title          String
  message        String?
  link           String?
  category       String        @default("info")
  readAt         DateTime?     @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_notifications_user_created")
  @@index([organizationId], map: "idx_notifications_org")
  @@map("notifications")
}

model Organization {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String
  legalName                 String?                    @map("legal_name")
  slug                      String?                    @unique
  logoUrl                   String?                    @map("logo_url")
  address                   String?
  city                      String?
  country                   String?
  phone                     String?
  email                     String?
  website                   String?
  rccm                      String?
  idNational                String?                    @map("id_national")
  taxNumber                 String?                    @map("tax_number")
  currency                  String                     @default("CDF")
  active                    Boolean                    @default(true)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)
  members                   OrganizationMember[]
  absenceJustifications     AbsenceJustification[]
  agentReports              AgentReport[]
  announcements             Announcement[]
  appSettings               AppSetting[]
  appointments              Appointment[]
  assistantRecords          AssistantRecord[]
  attendance                Attendance[]
  attendanceLocations       AttendanceLocation[]
  auditLogs                 AuditLog[]
  breakSessions             BreakSession[]
  candidates                Candidate[]
  contacts                  Contact[]
  departments               Department[]
  directionExecutives       DirectionExecutive[]
  directions                Direction[]
  documents                 Document[]
  employees                 Employee[]
  jobOffers                 JobOffer[]
  leaveRequests             LeaveRequest[]
  legalRecords              LegalRecord[]
  mailRegister              MailRegister[]
  meetingMinutes            MeetingMinute[]
  notifications             Notification[]
  payroll                   Payroll[]
  performanceReviewComments PerformanceReviewComment[]
  performanceReviews        PerformanceReview[]
  profiles                  Profile[]
  roleAuditLogs             RoleAuditLog[]
  talents                   Talent[]
  talentRewards             TalentReward[]
  taskChatMessages          TaskChatMessage[]
  taskComments              TaskComment[]
  tasks                     Task[]
  trainings                 Training[]
  userRoles                 UserRole[]
  wellbeingSurveys          WellbeingSurvey[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @unique @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_members")
}

model Payroll {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId          String        @map("employee_id") @db.Uuid
  period              String
  baseSalary          Decimal       @default(0) @map("base_salary") @db.Decimal(12, 2)
  bonus               Decimal       @default(0) @db.Decimal(12, 2)
  deductions          Decimal       @default(0) @db.Decimal(12, 2)
  netPay              Decimal       @map("net_pay") @ignore @db.Decimal(12, 2)
  status              String        @default("draft")
  paidAt              DateTime?     @map("paid_at") @db.Date
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  hoursWorked         Decimal       @default(0) @map("hours_worked") @db.Decimal
  hourlyRate          Decimal       @default(0) @map("hourly_rate") @db.Decimal
