# PostgreSQL local (remplacer le mot de passe par celui du compte PostgreSQL local)
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/rh_admin?schema=public"

# Clé secrète de session (générer une valeur aléatoire longue, au minimum 32 caractères)
AUTH_SECRET="CHANGE_ME_WITH_A_RANDOM_SECRET"

# SMTP pour l'envoi des courriels
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="CHANGE_ME"
SMTP_FROM="RH Admin <no-reply@example.com>"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
