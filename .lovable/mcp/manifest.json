{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://fjinuubbglswajfbommv.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "emergence-drc-mcp",
      "version": "0.1.0",
      "title": "Emergence DRC"
    },
    "tools": [
      {
        "name": "get_current_user",
        "title": "Get current user",
        "description": "Return the profile, roles, and linked employee record of the signed-in Emergence DRC user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_employees",
        "title": "List employees",
        "description": "List employees visible to the signed-in user (respects Emergence DRC access rules). Supports optional name/email search and a result limit.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "minLength": 1,
              "description": "Optional substring matched against first name, last name, or email."
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Maximum number of rows to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_reports",
        "title": "List reports",
        "description": "List Emergence DRC agent reports the signed-in user can see. Filter by status (draft, submitted, approved, rejected) and limit.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "submitted",
                "approved",
                "rejected"
              ]
            },
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_announcements",
        "title": "List announcements",
        "description": "List the most recent internal announcements visible to the signed-in user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
